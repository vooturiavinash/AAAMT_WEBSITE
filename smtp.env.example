# Copy this file to smtp.env and fill in your mail server values.
# Do NOT put secrets in frontend JS. Do NOT edit any existing backend .env file.
#
# Required:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="AAAMT Website <noreply@aaamt.in>"
