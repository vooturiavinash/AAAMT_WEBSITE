<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS: clean URLs + optional enquiry proxy (ARR).
  Hostinger uses .htaccess instead.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="EnquiryApiProxy" stopProcessing="true">
          <match url="^api/enquiry/?$" />
          <action type="Rewrite" url="https://communication.aaamt.in/api/Email/demo-survey" appendQueryString="false" />
        </rule>

        <!-- Redirect index.html → / -->
        <rule name="RedirectIndexHtml" stopProcessing="true">
          <match url="^index\.html$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>

        <!-- privacy-policy.html → /privacy-policy/ -->
        <rule name="RedirectPrivacyPolicyHtml" stopProcessing="true">
          <match url="^privacy-policy\.html$" ignoreCase="true" />
          <action type="Redirect" url="/privacy-policy/" redirectType="Permanent" />
        </rule>

        <!-- Redirect any other *.html → /page -->
        <rule name="RedirectHtmlExtension" stopProcessing="true">
          <match url="^(.+)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <rule name="PrivacyPolicyLegacyRedirect" stopProcessing="true">
          <match url="^(PRIVACY_POLICY\.html|privacy\.html)$" ignoreCase="true" />
          <action type="Redirect" url="/privacy-policy/" redirectType="Permanent" />
        </rule>

        <!-- Canonical trailing slash for privacy-policy -->
        <rule name="PrivacyPolicyTrailingSlash" stopProcessing="true">
          <match url="^privacy-policy$" ignoreCase="true" />
          <action type="Redirect" url="/privacy-policy/" redirectType="Permanent" />
        </rule>

        <!-- Extensionless → .html file (not when a directory exists) -->
        <rule name="CleanUrlToHtml" stopProcessing="true">
          <match url="^(.+?)/?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
